{
  "name": "@relaycode/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "npm run build -w @relaycode/protocol",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js serve",
    "prepair": "npm run build -w @relaycode/protocol",
    "pair": "tsx src/index.ts pair",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@relaycode/protocol": "0.1.0",
    "dotenv": "^17.4.2",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  }
}
