# The bridge is loopback-only by default. For a phone, keep it on loopback and
# publish it with Tailscale Serve instead of exposing this port publicly.
RELAYCODE_PORT=8787
RELAYCODE_HOST=127.0.0.1

# Colon-separated absolute workspace roots that mobile sessions may access.
RELAYCODE_WORKSPACE_ROOTS=/Users/you/Projects

# Optional public HTTPS URL created by Tailscale Serve.
# RELAYCODE_PUBLIC_URL=https://your-mac.your-tailnet.ts.net

# Development only. Production pairing tokens are generated by `npm run pair`.
# RELAYCODE_TOKEN=
